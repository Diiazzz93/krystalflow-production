# Local development only. Copy this file to .env:
#   cp .env.example .env
#
# The values below are the public Supabase project settings (the anon /
# publishable key). They are meant to be in the browser. Do not put the
# service-role key, Unleashed keys, or the webhook secret in git.
#
# Lovable injects VITE_* and server env vars when it builds and deploys.
# Cloudflare reads server env vars from the worker's Variables and Secrets.
# This file is only a template so a checkout still knows which names the
# app expects.

SUPABASE_PROJECT_ID="cvzoejeyhpibyxrxyavp"
SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImN2em9lamV5aHBpYnl4cnh5YXZwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk0MjIxOTksImV4cCI6MjA5NDk5ODE5OX0.LnRFetjgkNwAcl0XYEHKVuOK2-tvgKs8FSarb1tjTwc"
SUPABASE_URL="https://cvzoejeyhpibyxrxyavp.supabase.co"
VITE_SUPABASE_PROJECT_ID="cvzoejeyhpibyxrxyavp"
VITE_SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImN2em9lamV5aHBpYnl4cnh5YXZwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk0MjIxOTksImV4cCI6MjA5NDk5ODE5OX0.LnRFetjgkNwAcl0XYEHKVuOK2-tvgKs8FSarb1tjTwc"
VITE_SUPABASE_URL="https://cvzoejeyhpibyxrxyavp.supabase.co"

# Server-only. Required before the Fill Ready cron webhook will run.
# POST /api/public/hooks/sync-fill-ready
# Header: x-sync-webhook-secret: <this value>
#
# Set the same random value in:
#   - Cloudflare: worker → Settings → Variables and Secrets → secret
#     named SYNC_WEBHOOK_SECRET (or Lovable Cloud → Secrets, same name)
#   - The Supabase cron job / webhook that calls the URL, preferably
#     stored in Supabase Vault and sent as that header
# Leave this blank in the template. Put the real value only in .env
# (gitignored) and in those secret stores.
SYNC_WEBHOOK_SECRET=
